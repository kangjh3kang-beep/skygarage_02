{
  "name": "project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:database": "node scripts/test-governance-database.mjs",
    "test:database:wasm": "node scripts/test-governance-database.mjs --wasm",
    "test:finance": "node scripts/test-finance-database.mjs",
    "test:finance:wasm": "node scripts/test-finance-database.mjs --wasm",
    "test:erp": "node scripts/test-erp-database.mjs",
    "test:erp:wasm": "node scripts/test-erp-database.mjs --wasm",
    "inventory": "node scripts/page-inventory.mjs",
    "test:ui": "node --test --test-concurrency=1 tests/harness/ui-scenarios.mjs tests/harness/finance-journey.mjs tests/harness/onboarding-guidance.mjs tests/harness/evidence-workflow.mjs tests/harness/live-auth-ui.mjs",
    "test:harness": "npm run inventory -- --check && npm run test:contracts && npm run test:ui && npm run test:database:wasm && npm run test:finance:wasm && npm run test:erp:wasm"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "30.1.3",
    "pg": "8.16.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
