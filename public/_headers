# Entry points and the update check must always see the current deployment.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/app*
  Cache-Control: no-store
/sw.js
  Cache-Control: no-store
/manifest.json
  Cache-Control: no-cache, must-revalidate
/doelv/*
  Cache-Control: no-cache, must-revalidate
